[Unit]
Description=MediaMTX streaming server (pi-cam)
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/mediamtx /etc/picam/mediamtx.yml
Restart=always
RestartSec=3
User=picam
Group=video

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# MediaMTX needs to bind to privileged-ish ports (>1024 here, so this isn't
# strictly required, but kept for defense in depth if ports change).
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
