[Unit]
Description=pi-cam static web viewer (pan/zoom UI, talks to MediaMTX's HLS output)
After=network-online.target
Wants=network-online.target

[Service]
# Plain static file server — all auth happens browser-side against MediaMTX's
# HLS endpoint, this just serves index.html/app.js/style.css. Loopback-only;
# the only way in is Tailscale Funnel's local reverse proxy
# (see scripts/tailscale-funnel.sh). scripts/firewall.sh also drops any
# external packets to this port as defense in depth.
WorkingDirectory=/etc/picam/web
ExecStart=/usr/bin/python3 -m http.server 8080 --bind 127.0.0.1
Restart=always
RestartSec=3
User=picam
Group=picam

NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
