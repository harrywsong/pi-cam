[Unit]
Description=pi-cam webcam+mic capture -> MediaMTX (RTSP publish)
After=network-online.target mediamtx.service
Wants=network-online.target
Requires=mediamtx.service

[Service]
# EnvironmentFile holds the publisher password and audio device — keep it
# out of git. See docs/SETUP.md for how to create /etc/picam/ffmpeg.env
# (must define PICAM_PUBLISHER_PASS and PICAM_AUDIO_DEVICE).
EnvironmentFile=/etc/picam/ffmpeg.env
# Audio is encoded as Opus (not AAC) so MediaMTX can hand it straight to
# WebRTC viewers without transcoding. This is listen-in only — the Pi has
# no speaker, so there is no talk-back path.
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning \
  -f v4l2 -input_format mjpeg -video_size 1280x720 -framerate 15 -i /dev/video0 \
  -f alsa -i ${PICAM_AUDIO_DEVICE} \
  -map 0:v -map 1:a \
  -c:v libx264 -preset veryfast -tune zerolatency -b:v 1200k -maxrate 1200k -bufsize 2400k \
  -c:a libopus -b:a 64k -ar 48000 -ac 1 \
  -f rtsp -rtsp_transport tcp rtsp://publisher:${PICAM_PUBLISHER_PASS}@127.0.0.1:8554/home
Restart=always
RestartSec=3
User=picam
Group=video
SupplementaryGroups=audio

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
