[Unit]
Description=pi-cam webcam+mic capture -> MediaMTX (RTSP publish)
After=network-online.target mediamtx.service
Wants=network-online.target
Requires=mediamtx.service

[Service]
# EnvironmentFile holds the publisher password and audio device — keep it
# out of git. See docs/SETUP.md for how to create /etc/picam/ffmpeg.env
# (must define PICAM_PUBLISHER_PASS and PICAM_AUDIO_DEVICE).
EnvironmentFile=/etc/picam/ffmpeg.env
# Audio is encoded as AAC, which both MPEG-TS HLS and native Safari/iOS
# playback expect. This is listen-in only — the Pi has no speaker, so there
# is no talk-back path.
#
# -g/-keyint_min 30 (1s GOP at 30fps) + -sc_threshold 0 give MediaMTX a
# keyframe exactly once a second to cut LL-HLS segments on, instead of
# wherever scene-change detection happens to land one. -bf 0 drops B-frames,
# which otherwise add reordering (and therefore latency) for no benefit at
# this bitrate/content type.
#
# -use_wallclock_as_timestamps on both inputs + -thread_queue_size: the
# webcam's v4l2 clock and the mic's ALSA clock are two independent hardware
# clocks that drift against each other. Without a shared timestamp source,
# that drift makes ffmpeg progressively duplicate frames to keep the two
# streams in sync ("More than N frames duplicated", growing over a session)
# and can eventually show up as an ALSA buffer xrun. Timestamping both off
# wallclock instead removes the drift; the larger thread queue absorbs
# scheduling jitter under CPU contention without triggering it either.
ExecStart=/usr/bin/ffmpeg -hide_banner -loglevel warning \
  -use_wallclock_as_timestamps 1 -thread_queue_size 1024 \
  -f v4l2 -input_format mjpeg -video_size 1920x1080 -framerate 30 -i /dev/video0 \
  -use_wallclock_as_timestamps 1 -thread_queue_size 1024 \
  -f alsa -i ${PICAM_AUDIO_DEVICE} \
  -map 0:v -map 1:a \
  -c:v libx264 -preset veryfast -tune zerolatency -g 30 -keyint_min 30 -sc_threshold 0 -bf 0 \
  -b:v 3000k -maxrate 3000k -bufsize 3000k \
  -c:a aac -b:a 96k -ar 44100 -ac 1 -af aresample=async=1 \
  -f rtsp -rtsp_transport tcp rtsp://publisher:${PICAM_PUBLISHER_PASS}@127.0.0.1:8554/home
Restart=always
RestartSec=3
User=picam
Group=video
SupplementaryGroups=audio

# Hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
